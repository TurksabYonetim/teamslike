# =============================================================================
# TeamsLike API — PRODUCTION env template
# Copy to `infra/.env.prod` and fill in real values. Never commit `.env.prod`.
# =============================================================================

# ---- App ----
APP_NAME=TeamsLike API
APP_ENV=production
APP_DEBUG=false
APP_PORT=8800

# Comma-separated list of allowed origins (no spaces).
# Example: https://app.teamslike.com,https://admin.teamslike.com
CORS_ALLOWED_ORIGINS=https://app.teamslike.com

# ---- Database (compose-internal hostname: postgres) ----
POSTGRES_DB=teamslike
POSTGRES_USER=teamslike
POSTGRES_PASSWORD=__CHANGE_ME__
DATABASE_URL=postgresql+asyncpg://teamslike:__CHANGE_ME__@postgres:5432/teamslike
DATABASE_ECHO=false

# ---- Redis (compose-internal hostname: redis) ----
REDIS_PASSWORD=__CHANGE_ME__
REDIS_URL=redis://:__CHANGE_ME__@redis:6379/0
REDIS_KEY_PREFIX=teamslike

# ---- JWT (API auth) ----
# Generate with: openssl rand -hex 64
JWT_SECRET_KEY=__CHANGE_ME__
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=14

# ---- Jitsi (separate stack; values must match Jitsi side) ----
JITSI_PUBLIC_URL=https://meet.teamslike.com
JITSI_DOMAIN=meet.teamslike.com
JITSI_JWT_APP_ID=teamslike
JITSI_JWT_APP_SECRET=__CHANGE_ME__
JITSI_JWT_ALGORITHM=HS256
JITSI_JWT_TOKEN_TTL_MINUTES=120

# ---- Chatwoot (separate stack) ----
CHATWOOT_BASE_URL=https://support.teamslike.com
CHATWOOT_USER_API_TOKEN=__CHANGE_ME__
CHATWOOT_ACCOUNT_ID=1

# ---- Gunicorn ----
GUNICORN_WORKERS=4
GUNICORN_TIMEOUT=60

# ---- Deploy / TLS (Caddy serves all three domains) ----
# All domains must point to this server's IP (A record).
API_DOMAIN=api.teamslike.com
CHATWOOT_DOMAIN=support.teamslike.com
JITSI_DOMAIN=meet.teamslike.com
# Email Let's Encrypt uses for cert expiry notifications.
ACME_EMAIL=admin@teamslike.com

# ---- Image ----
# Build locally with: docker compose -f infra/docker-compose.prod.yml build
# Or pull from registry by setting:
# API_IMAGE=ghcr.io/turksabyonetim/teamslike-api:sha-xxxxxxx
API_IMAGE=teamslike-api:latest
