# =============================================================================
# Chatwoot — production env template
# Copy to `infra/chatwoot/.env` and fill in real values.
#
# Generate secrets with: openssl rand -hex 64
# =============================================================================

# Image pin — verify latest stable at https://hub.docker.com/r/chatwoot/chatwoot/tags
CHATWOOT_IMAGE=chatwoot/chatwoot:v4.4.0

# Public URL Caddy serves Chatwoot under
FRONTEND_URL=https://support.teamslike.com
INSTALLATION_NAME=TeamsLike Support
DEFAULT_LOCALE=tr

# Rails
SECRET_KEY_BASE=__CHANGE_ME_openssl_rand_hex_64__
RAILS_ENV=production
RAILS_LOG_TO_STDOUT=true
RAILS_MAX_THREADS=5
FORCE_SSL=true
ENABLE_ACCOUNT_SIGNUP=false

# Database (internal — chatwoot-postgres service)
POSTGRES_HOST=chatwoot-postgres
POSTGRES_PORT=5432
POSTGRES_DATABASE=chatwoot
POSTGRES_USERNAME=chatwoot
POSTGRES_PASSWORD=__CHANGE_ME__

# Redis (internal — chatwoot-redis service)
REDIS_URL=redis://:__CHANGE_ME__@chatwoot-redis:6379
REDIS_PASSWORD=__CHANGE_ME__

# Mailer (SMTP). Use your provider (Postmark, SES, Mailgun, etc.)
MAILER_SENDER_EMAIL=Chatwoot <support@teamslike.com>
SMTP_DOMAIN=teamslike.com
SMTP_ADDRESS=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=__CHANGE_ME__
SMTP_PASSWORD=__CHANGE_ME__
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=true

# Active Storage — local (mount volume) or S3-compatible
ACTIVE_STORAGE_SERVICE=local
# For S3: ACTIVE_STORAGE_SERVICE=amazon, plus AWS_* keys
