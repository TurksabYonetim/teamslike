APP_NAME=TeamsLike API
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8800

# Comma-separated list of allowed origins. Empty = no CORS.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

DATABASE_URL=postgresql+asyncpg://teamslike:CHANGEME@127.0.0.1:5434/teamslike
DATABASE_ECHO=false

REDIS_URL=redis://:CHANGEME@127.0.0.1:6380/0
REDIS_KEY_PREFIX=teamslike

JWT_SECRET_KEY=CHANGEME_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=14

JITSI_PUBLIC_URL=https://localhost:8443
JITSI_JWT_APP_ID=teamslike
JITSI_JWT_APP_SECRET=CHANGEME_openssl_rand_hex_32
JITSI_JWT_ALGORITHM=HS256
JITSI_JWT_TOKEN_TTL_MINUTES=120
JITSI_DOMAIN=meet.jitsi

CHATWOOT_BASE_URL=http://127.0.0.1:3000
CHATWOOT_USER_API_TOKEN=REPLACE_WITH_CHATWOOT_USER_API_TOKEN
CHATWOOT_ACCOUNT_ID=1

POSTGRES_PASSWORD=CHANGEME
REDIS_PASSWORD=CHANGEME
