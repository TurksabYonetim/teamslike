# =============================================================================
# Jitsi Meet — production env template
# Copy to `infra/jitsi/.env` and fill in real values.
#
# Generate every password with: openssl rand -hex 32
# JWT_APP_SECRET MUST match TeamsLike API's JITSI_JWT_APP_SECRET.
# =============================================================================

# Image pins — verify latest stable tag at https://hub.docker.com/u/jitsi
JITSI_IMAGE_TAG=stable-10310

# Public URL and domain — Caddy serves Jitsi here
PUBLIC_URL=https://meet.teamslike.com
HTTP_PORT=8000
HTTPS_PORT=8443

# Timezone
TZ=Europe/Istanbul

# JVB (video bridge) — must be reachable on UDP 10000 from clients
# Set to the server's public IP, or leave empty to auto-detect
DOCKER_HOST_ADDRESS=

# ---- Internal component passwords (generate fresh, do not reuse) ----
JICOFO_AUTH_PASSWORD=__CHANGE_ME__
JVB_AUTH_PASSWORD=__CHANGE_ME__
JIBRI_RECORDER_PASSWORD=__CHANGE_ME__
JIBRI_XMPP_PASSWORD=__CHANGE_ME__
JICOFO_COMPONENT_SECRET=__CHANGE_ME__

# ---- JWT auth (TeamsLike API signs tokens, Prosody verifies them) ----
ENABLE_AUTH=1
ENABLE_GUESTS=0
AUTH_TYPE=jwt
JWT_APP_ID=teamslike
JWT_APP_SECRET=__MUST_MATCH_API_JITSI_JWT_APP_SECRET__
JWT_ACCEPTED_ISSUERS=teamslike
JWT_ACCEPTED_AUDIENCES=teamslike

# Disable Jitsi's built-in Let's Encrypt — Caddy handles TLS upstream
ENABLE_LETSENCRYPT=0
DISABLE_HTTPS=1

# Branding / behavior
ENABLE_RECORDING=0
ENABLE_TRANSCRIPTIONS=0
ENABLE_PREJOIN_PAGE=1
ENABLE_WELCOME_PAGE=0

# Config volume root (host path containing web/, prosody/, jicofo/, jvb/ subdirs)
# These get created automatically on first start.
CONFIG=./jitsi-config
